DATABASE_URL=postgresql+psycopg2://erp:erp@localhost:5432/erp
REDIS_URL=redis://localhost:6379/0
# активная заглушка ≥32 байт: даже забытый при деплое .env не оставляет короткий секрет
JWT_SECRET=7d044309f38543a3b60152c2785db09acc39c4f4ea714b5f25ec59b7856fdb0f
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=14
SECRETS_KEY=change-me-fernet-key
CORS_ORIGINS=["http://localhost:5173"]

# Бэкапы и обновления (updates-and-backups-spec)
BACKUP_KEY=KbPbCqtmutVQDaMHVvNSte7n0_F8VkalqpAkmWed5js=
BACKUP_DIR=/backups
BACKUP_RETENTION=3
BACKUP_SCHEDULE=03:00
UPDATE_MANIFEST_URL=file:///app/deploy/test-manifest.json

# ИИ-агент (ADR-006): дев/тесты — llm_mock; живой Ollama — ollama
# (7B требует ~5 ГБ RAM VM; на <=8 ГБ — qwen2.5:3b-instruct, см. README)
AI_PROVIDER=llm_mock
AI_CHAT_MODEL=qwen2.5:7b-instruct
# pull_models с хоста: OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# ПРОДА: секреты генерируются один раз при развёртывании и хранятся только
# в .env на сервере (не в git). Минимумы: JWT_SECRET ≥ 32 байт, SECRETS_KEY —
# ключ Fernet (32 байта base64-url; получить: python -c "from cryptography.
# fernet import Fernet; print(Fernet.generate_key().decode())").
# Если JWT_SECRET короче 32 байт — api стартует с InsecureKeyLengthWarning.
# ---------------------------------------------------------------------------
# JWT_SECRET=$(openssl rand -hex 32)     # ≥32 байт, пример структуры:
# JWT_SECRET=9f2c1d4e8a7b6f5c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0
# SECRETS_KEY=$(python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# Исходящие домены коннекторов (security-plan P1 п.7): запятая, без пробелов.
# В ДЕВЕ strict=false (свободный режим); управление прод-списком —
# платформенный админ: Интеграции → «Безопасность сети»
# (GET/PUT /platform/egress-settings — Settings поверх этих дефолтов).
CONNECTOR_ALLOWLIST=yookassa.net,api.yookassa.ru,securepay.tinkoff.ru,api.telegram.org,api-seller.ozon.ru,localhost,127.0.0.1,host.docker.internal
CONNECTOR_ALLOWLIST_STRICT=false
# ПРОД: strict=true — обращения к доменам вне списка блокируются
# (EgressBlocked «домен X не в белом списке; добавьте через платформенного админа»)
CONNECTOR_ALLOWLIST_STRICT=true

# Прод-стек ИИ: AI_PROVIDER=ollama (mock — только для smoke явным override)
# AI_PROVIDER=ollama
